# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (change this in production)
JWT_SECRET=srujan-events-secret-key-change-in-production

# Email Configuration (for contact form notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Admin Email (where contact form submissions are sent)
ADMIN_EMAIL=admin@srujanevents.com

# SMS Configuration (optional - for SMS notifications)
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=SRUJAN

# Database Configuration (if using a database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=srujan_events
DB_USER=your-db-user
DB_PASS=your-db-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100